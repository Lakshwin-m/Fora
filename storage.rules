rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Avatar uploads — unchanged
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Capsule files — owner writes, owner + recipients read
    match /capsules/{capsuleId}/{allPaths=**} {

      allow read: if request.auth != null
        && (
          // Owner always has access
          firestore.get(/databases/(default)/documents/capsules/$(capsuleId)).data.userId
            == request.auth.uid
          // Recipients have access
          || request.auth.uid in
             firestore.get(/databases/(default)/documents/capsules/$(capsuleId)).data.recipients
        );

      allow write: if request.auth != null
        && request.resource.size <= 50 * 1024 * 1024;

      allow delete: if request.auth != null;
    }

    // Strict fallback — block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
